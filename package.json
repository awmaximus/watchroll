  "scripts": {
    "test": "node --test \"common/tests/*.test.js\"",
    "lint": "./build-firefox.sh --skip-tests",
    "build": "./build-firefox.sh",
    "build:firefox": "./build-firefox.sh",
    "start": "./build-firefox.sh --run"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/awmaximus/watchroll#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awmaximus/watchroll.git"
  },
  "bugs": {
    "url": "https://github.com/awmaximus/watchroll/issues"
  }
