{
  "name": "watchroll",
  "version": "1.1.0",
  "private": true,
  "description": "Watchroll: unofficial Firefox extension that tracks new anime episodes from your Crunchyroll Watchlist and Crunchylists, sub or dub, with a release calendar and notifications.",
  "license": "MIT",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "lint": "./build.sh --skip-tests",
    "build": "./build.sh",
    "start": "npx --yes web-ext@10 run --start-url https://www.crunchyroll.com/"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/awmaximus/watchroll#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awmaximus/watchroll.git"
  },
  "bugs": {
    "url": "https://github.com/awmaximus/watchroll/issues"
  }
}
