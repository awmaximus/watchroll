{
  "name": "watchroll",
  "version": "1.2.1",
  "private": true,
  "description": "Watchroll: unofficial browser extension (Firefox now; Chrome planned) that tracks new anime episodes from your Crunchyroll Watchlist and Crunchylists, sub or dub, with a release calendar and notifications.",
