{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "en_US",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "homepage_url": "https://github.com/awmaximus/watchroll",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": "icons/icon.svg"
  },
  "background": {
    "scripts": [
      "src/i18n.js",
      "src/api.js",
      "src/analyzer.js",
      "src/checker.js",
      "src/background.js"
    ]
  },
  "incognito": "not_allowed",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.crunchyroll.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.crunchyroll.com/*"
      ],
      "js": [
        "src/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.crunchyroll.com/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "crunchyroll-novos-eps@awmaximus.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "searchTerms"
        ]
      }
    }
  }
}
